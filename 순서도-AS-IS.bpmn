        <bpmn:outgoing>Flow_ASIS_MDA_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_ASIS_MDA_01" name="개인별 예제·Notebook 탐색 [W] · 8h">
        <bpmn:documentation>PI 이슈: Waste. 가정 Lead Time: 8h. 현장 확인 전 AS-IS 가설 단계.</bpmn:documentation>
        <bpmn:incoming>Flow_ASIS_MDA_01</bpmn:incoming>
        <bpmn:outgoing>Flow_ASIS_MDA_02</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_ASIS_MDA_02" name="과거 코드 복사·개별 구현 [B/W] · 48h">
        <bpmn:documentation>PI 이슈: Bottleneck, Waste. 가정 Lead Time: 48h. 현장 확인 전 AS-IS 가설 단계.</bpmn:documentation>
