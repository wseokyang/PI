      <bpmn:sequenceFlow id="Flow_ASIS_TDS_02" sourceRef="Task_ASIS_TDS_01" targetRef="Task_ASIS_TDS_02" />
      <bpmn:sequenceFlow id="Flow_ASIS_TDS_03" sourceRef="Task_ASIS_TDS_02" targetRef="Task_ASIS_TDS_03" />
      <bpmn:sequenceFlow id="Flow_ASIS_TDS_04" sourceRef="Task_ASIS_TDS_03" targetRef="End_ASIS_TDS" />
    </bpmn:subProcess>
