        <bpmn:documentation>PI 이슈: Bottleneck, Waste. 가정 Lead Time: 4h. 현장 확인 전 AS-IS 가설 단계.</bpmn:documentation>
        <bpmn:incoming>Flow_ASIS_DQC_01</bpmn:incoming>
        <bpmn:outgoing>Flow_ASIS_DQC_02</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_ASIS_DQC_02" name="오류 원인 확인·재추출 요청 [B/D] · 6h">
