      <bpmn:sequenceFlow id="Flow_ASIS_MTR_03" sourceRef="Task_ASIS_MTR_02" targetRef="Task_ASIS_MTR_03" />
      <bpmn:sequenceFlow id="Flow_ASIS_MTR_04" sourceRef="Task_ASIS_MTR_03" targetRef="End_ASIS_MTR" />
