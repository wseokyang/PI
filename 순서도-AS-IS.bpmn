    <bpmn:sequenceFlow id="Flow_Feasibility_To_Environment_Merge" sourceRef="Task_AI_Feasibility" targetRef="Gateway_Development_Environment_Merge" />
    <bpmn:sequenceFlow id="Flow_Environment_Merge_To_ASIS_DEV" sourceRef="Gateway_Development_Environment_Merge" targetRef="SubProcess_ASIS_DEV" />
