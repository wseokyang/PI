        <bpmn:documentation>PI 이슈: Bottleneck, Delay. 가정 Lead Time: 2h. 현장 확인 전 AS-IS 가설 단계.</bpmn:documentation>
        <bpmn:incoming>Flow_ASIS_TDS_01</bpmn:incoming>
        <bpmn:outgoing>Flow_ASIS_TDS_02</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_ASIS_TDS_02" name="파일 수동 매칭·병합 [B/W] · 3h">
        <bpmn:documentation>PI 이슈: Bottleneck, Waste. 가정 Lead Time: 3h. 현장 확인 전 AS-IS 가설 단계.</bpmn:documentation>
        <bpmn:incoming>Flow_ASIS_TDS_02</bpmn:incoming>
        <bpmn:outgoing>Flow_ASIS_TDS_03</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_ASIS_TDS_03" name="Train/Valid/Test 수동 분할·버전관리 [B/D/W] · 3h">
