        <bpmn:documentation>PI 이슈: Delay, Waste. 가정 Lead Time: 2h. 현장 확인 전 AS-IS 가설 단계.</bpmn:documentation>
        <bpmn:incoming>Flow_ASIS_CIM_01</bpmn:incoming>
        <bpmn:outgoing>Flow_ASIS_CIM_02</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_ASIS_CIM_02" name="개인 코드 사본 수정 [B/D] · 8h">
