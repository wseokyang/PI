        <bpmn:incoming>Flow_ASIS_DQC_02</bpmn:incoming>
        <bpmn:outgoing>Flow_ASIS_DQC_03</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_ASIS_DQC_03" name="검증 결과 Excel 보고서 작성 [D/W] · 2h">
